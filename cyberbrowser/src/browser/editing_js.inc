"                items.unshift(ancestorContainer);\n"
"            }\n"
"        }\n"
"        for (\n"
"            var ancestorContainer = range.startContainer;\n"
"            ancestorContainer;\n"
"            ancestorContainer = ancestorContainer.parentNode\n"
"        ) {\n"
"            if (isHtmlElement(ancestorContainer, \"li\")) {\n"
"                items.unshift(ancestorContainer);\n"
"            }\n"
