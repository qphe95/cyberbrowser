"        getSelection().collapse(newContainer, 0);\n"
"        getActiveRange().setStart(newContainer, 0);\n"
"        getActiveRange().setEnd(newContainer, 0);\n"
"\n"
"        // \"Return true.\"\n"
"        return true;\n"
"    }\n"
