"//@}\n"
"///// Indenting and outdenting /////\n"
"//@{\n"
"\n"
"function indentNodes(nodeList) {\n"
"    // \"If node list is empty, do nothing and abort these steps.\"\n"
"    if (!nodeList.length) {\n"
"        return;\n"
"    }\n"
"\n"
"    // \"Let first node be the first member of node list.\"\n"
"    var firstNode = nodeList[0];\n"
