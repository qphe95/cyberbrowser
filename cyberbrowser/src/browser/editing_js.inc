"        }\n"
"\n"
"        // \"If new container has no visible children, call createElement(\"br\")\n"
"        // on the context object, and append the result as the last child of\n"
"        // new container.\"\n"
"        if (![].some.call(newContainer.childNodes, isVisible)) {\n"
